---
import { ChevronDown, ChevronRight, MoveDown } from "@lucide/astro";
import SeoHead from "./SeoHead.astro";
import type { en } from "../i18n/en";
import type { nl } from "../i18n/nl";
import { design } from "../config/design";
import { events } from "../config/events";
import "../styles/global.css";

type Copy = typeof en | typeof nl;
interface Props { copy: Copy; }

const { copy } = Astro.props;
const pageStyle = `--color-black:${design.colors.black};--color-white:${design.colors.white};--color-grey:${design.colors.grey};--color-light-grey:${design.colors.lightGrey};--color-pink:${design.colors.pink};`;
const shellClass = "w-full px-[16px] md:px-[32px]";
const desktopAlignmentClass = "md:max-w-[1500px]";
const faqContentClass = "md:max-w-[570px]";
const buttonStyle = `border-radius:${design.buttonRadius}px;min-height:${design.buttonHeight}px;`;
const eventDateFormatter = new Intl.DateTimeFormat(copy.locale === "nl" ? "nl-NL" : "en-US", { month: "short", day: "numeric", hour: "numeric", minute: "2-digit", timeZone: "Europe/Amsterdam" });
---

<html lang={copy.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead title={copy.seo.home.title} description={copy.seo.home.description} locale={copy.locale} page="home" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Titillium+Web:wght@300;400;600&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[var(--color-white)] text-[var(--color-black)]" style={pageStyle}>
    <main>
      <section class="landing-hero relative h-screen max-h-[1080px] min-h-[640px] bg-cover bg-center text-[var(--color-white)]">
        <header class="absolute inset-x-0 top-0 z-10 py-[16px] md:py-[24px]">
          <nav class={`${shellClass} flex justify-end gap-[12px]`} aria-label="Primary">
            <a class={`${design.typography.button} underline-offset-4 hover:underline`} href="/" aria-current={copy.locale === "en" ? "page" : undefined}>EN</a>
            <a class={`${design.typography.button} underline-offset-4 hover:underline`} href="/nl/" aria-current={copy.locale === "nl" ? "page" : undefined}>NL</a>
          </nav>
        </header>
        <div class={`${shellClass} flex h-full flex-col pt-[35vh] md:pt-[30vh]`}>
          <h1 class={design.typography.h1}>{copy.hero.title[0]}<br />{copy.hero.title[1]}</h1>
          <p class={`${design.typography.p1} mt-[30px] md:mt-[30px]`}>{copy.hero.subtitle[0]}<br class="md:hidden" />{copy.hero.subtitle[1]}</p>
          <a class={`${design.typography.button} mt-[40px] inline-flex w-fit items-center gap-[8px] bg-[var(--color-white)] px-[18px] text-[var(--color-black)] md:mt-[50px]`} style={buttonStyle} href="#events" data-events-scroll>
            {copy.hero.button}<ChevronRight size={18} aria-hidden="true" />
          </a>
          <a class="-ml-[17px] mb-[32px] mt-auto inline-flex w-fit md:-ml-[22px]" href="#discover" aria-label={copy.hero.scrollLabel} data-hero-scroll>
            <MoveDown class="h-[55px] w-[55px] md:h-[65px] md:w-[65px]" stroke-width={1.25} aria-hidden="true" />
          </a>
        </div>
      </section>

      <section id="discover" class={`${shellClass} landing-discover mt-[35vh] md:mt-[45vh]`}>
        <h2 class={design.typography.h2}>{copy.discover.title[0]}<br class="md:hidden" /> {copy.discover.title[1]}</h2>
        <p class={`${design.typography.discoverBody} mt-[25px] max-w-[535px] text-[var(--color-grey)] md:mt-[40px] md:max-w-[720px]`}>{copy.discover.body}</p>
      </section>

      <section class={`${shellClass} landing-vibe mt-[220px] md:mt-[45vh]`}>
        <h2 class={design.typography.h2}>{copy.vibe.title[0]}<br />{copy.vibe.title[1]}</h2>
        <p class={`${design.typography.vibeBody} mt-[25px] text-[var(--color-grey)] md:mt-[32px]`}>{copy.vibe.body[0]}<br class="hidden md:block" /> {copy.vibe.body[1]}</p>
        <div class="mt-[40px] md:mt-[60px]">
          <div class="hidden gap-[8px] md:grid md:grid-cols-3 md:grid-rows-2">
            <img class="row-span-2 h-full w-full object-cover" src="/images/vibe_desktop_1.webp" alt={copy.vibe.images[0]} loading="lazy" />
            <img class="h-full w-full object-cover" src="/images/vibe_desktop_2.webp" alt={copy.vibe.images[1]} loading="lazy" />
            <img class="h-full w-full object-cover" src="/images/vibe_desktop_3.webp" alt={copy.vibe.images[2]} loading="lazy" />
            <img class="h-full w-full object-cover" src="/images/vibe_desktop_4.webp" alt={copy.vibe.images[3]} loading="lazy" />
            <img class="h-full w-full object-cover" src="/images/vibe_desktop_5.webp" alt={copy.vibe.images[4]} loading="lazy" />
          </div>
          <div class="grid gap-[8px] md:hidden">
            <img class="h-[185px] w-full object-cover" src="/images/vibe_mobile_1.webp" alt={copy.vibe.images[0]} loading="lazy" />
            <img class="h-[412px] w-full object-cover" src="/images/vibe_mobile_2.webp" alt={copy.vibe.images[1]} loading="lazy" />
            <img class="h-[185px] w-full object-cover" src="/images/vibe_mobile_3.webp" alt={copy.vibe.images[2]} loading="lazy" />
          </div>
        </div>
      </section>

      <section id="how-it-works" class={`${shellClass} landing-how-it-works mt-[220px] md:mt-[35vh]`}>
        <h2 class={design.typography.h2}>{copy.steps.title}</h2>
        <div class={`${desktopAlignmentClass} mt-[35px] border-y border-[var(--color-light-grey)] md:mt-[45px] md:grid md:grid-cols-[calc(40%_-_60px)_40%_calc(20%_+_60px)] md:border-y-0`}>
          {copy.steps.items.map((item) => (
            <article class="grid grid-cols-[40px_1fr] gap-[16px] border-b border-[var(--color-light-grey)] py-[20px] last:border-b-0 md:grid-cols-[28px_1fr] md:gap-[32px] md:border-b-0 md:border-l md:border-[var(--color-light-grey)] md:py-0 md:pl-[28px] first:md:border-l-0 first:md:pl-0 last:md:w-[496px]">
              <p class="text-[30px] font-light leading-[150%] text-[var(--color-pink)] md:text-[36px]">{item.label.replace(" /", "")}</p>
              <div class="md:max-w-[420px]"><h3 class={design.typography.stepTitle}>{item.title}</h3><p class={`${design.typography.p3} mt-[4px] text-[var(--color-grey)]`}>{item.body}</p></div>
            </article>
          ))}
        </div>
      </section>

      <section id="events" class={`${shellClass} landing-events mt-[220px] scroll-mt-[64px] md:mt-[35vh]`}>
        <h2 class={design.typography.h2}>{copy.events.title}</h2>
        <div class="mt-[40px] border-t border-[var(--color-light-grey)] md:mt-[45px]">
          {events.map((event) => (
            <article class="border-b border-[var(--color-light-grey)] py-[25px]">
              <div class={`${desktopAlignmentClass} grid grid-cols-[minmax(0,1fr)_105px] items-center gap-[16px] md:grid-cols-[calc(40%_+_28px)_18.666667%_21.333333%_calc(20%_-_28px)] md:gap-0`}>
                <div><h3 class={design.typography.h3}>{copy.locale === "en" ? event.locationEn : event.location}</h3><p class={`${design.typography.eventMeta} mt-[4px] text-[var(--color-grey)] md:hidden`}>{eventDateFormatter.format(new Date(event.date))}<br />{copy.events.city}</p></div>
                <p class={`${design.typography.eventMeta} hidden text-[var(--color-grey)] md:block`}>{eventDateFormatter.format(new Date(event.date))}</p>
                <p class={`${design.typography.eventMeta} hidden text-[var(--color-grey)] md:translate-x-[32px] md:block`}>{copy.events.city}</p>
                <a class={`luma-checkout--button ${design.typography.button} inline-flex w-[105px] items-center justify-center gap-[5px] bg-[var(--color-black)] px-[12px] text-[var(--color-white)] md:w-[135px]`} style={buttonStyle} href={event.lumaUrl} data-luma-action="checkout" data-luma-event-id={event.lumaEventId}>{copy.events.button}<ChevronRight size={16} aria-hidden="true" /></a>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="faq" class={`${shellClass} mt-[120px] mb-[45px] md:mt-[200px] md:mb-[64px]`}>
        <details class="group/faq" data-faq-panel>
          <summary class={`${design.typography.faqTitle} cursor-pointer list-none outline-none`}>
            <div class={`${faqContentClass} flex items-center gap-[6px]`}>
              <span>{copy.faq.title}</span>
              <ChevronRight class="group-open/faq:hidden" size={20} aria-hidden="true" />
              <ChevronDown class="hidden group-open/faq:block" size={20} aria-hidden="true" />
            </div>
          </summary>
          <div class="mt-[25px] border-t border-[var(--color-light-grey)]">
            {copy.faq.items.map((item) => (
              <article class="border-b border-[var(--color-light-grey)] py-[25px]">
                <div class={faqContentClass}>
                  <h3 class={design.typography.p2}>{item.question}</h3>
                  <p class={`${design.typography.p} mt-[10px] text-[var(--color-grey)]`}>{item.paragraphs.join(" ")}</p>
                  {"link" in item && item.link && <a class={`${design.typography.p2} mt-[12px] inline-block`} href={item.link.href}>{item.link.label}</a>}
                </div>
              </article>
            ))}
          </div>
        </details>
      </section>
    </main>
    <script id="luma-checkout" src="https://embed.lu.ma/checkout-button.js"></script>
    <style>
      @media (min-width: 1921px) {
        .landing-discover {
          margin-top: 225px;
        }

        .landing-vibe {
          margin-top: 300px;
        }

        .landing-how-it-works {
          margin-top: 250px;
        }

        .landing-events {
          margin-top: 225px;
        }
      }
    </style>
    <script>
      const heroScroll = document.querySelector("[data-hero-scroll]");
      const eventsScroll = document.querySelector("[data-events-scroll]");
      const faqPanel = document.querySelector("[data-faq-panel]");

      if (heroScroll instanceof HTMLAnchorElement) {
        heroScroll.addEventListener("click", (event) => {
          const target = document.querySelector(heroScroll.hash);
          if (!(target instanceof HTMLElement)) return;

          event.preventDefault();
          const desktop = window.matchMedia("(min-width: 768px)").matches;
          const offset = desktop ? window.innerHeight * 0.35 : 64;
          const top = target.getBoundingClientRect().top + window.scrollY - offset;

          window.scrollTo({ top, behavior: "smooth" });
        });
      }

      if (eventsScroll instanceof HTMLAnchorElement) {
        eventsScroll.addEventListener("click", (event) => {
          if (window.matchMedia("(min-width: 768px)").matches) return;

          const target = document.querySelector(eventsScroll.hash);
          if (!(target instanceof HTMLElement)) return;

          event.preventDefault();
          const top = target.getBoundingClientRect().top + window.scrollY - 64;

          window.scrollTo({ top, behavior: "smooth" });
        });
      }

      if (window.location.hash === "#events") {
        window.addEventListener("load", () => {
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              const target = document.querySelector("#events");
              if (!(target instanceof HTMLElement)) return;

              const top = target.getBoundingClientRect().top + window.scrollY - 64;
              window.scrollTo({ top, behavior: "auto" });
            });
          });
        }, { once: true });
      }

      if (faqPanel instanceof HTMLDetailsElement) {
        faqPanel.addEventListener("toggle", () => {
          if (!faqPanel.open) return;

          requestAnimationFrame(() => {
            const offset = 40;
            const top = faqPanel.getBoundingClientRect().top + window.scrollY - offset;

            window.scrollTo({ top, behavior: "smooth" });
          });
        });
      }
    </script>
  </body>
</html>
